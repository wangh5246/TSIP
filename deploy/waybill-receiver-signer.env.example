# Install as /etc/waybill/receiver-signer.env, owned by root:root and mode 0600.
# Generate three different 32-byte random tokens; never reuse Charger admin/pepper.
WAYBILL_RECEIVER_DB=/var/lib/waybill-receiver/receiver.sqlite3
WAYBILL_RECEIVER_KEY_FILE=/var/lib/waybill-receiver/receiver-ed25519.key
WAYBILL_RECEIVER_POLICY_PROFILE=/opt/waybill-formal/current/configs/settlement_policy_profiles/ruc-demo-v9.json
WAYBILL_RECEIVER_ACQUISITION_TOKEN=CHANGE_ME
WAYBILL_RECEIVER_PROVER_TOKEN=CHANGE_ME
WAYBILL_RECEIVER_CHARGER_DEVICE_TOKEN=CHANGE_ME
WAYBILL_RECEIVER_ID=receiver-01
WAYBILL_RECEIVER_DEVICE_ID=dev-v6
WAYBILL_CHARGER_DOMAIN=ruc-demo.charger-01
WAYBILL_RECEIVER_CHARGER_URL=https://127.0.0.1:8443
WAYBILL_RECEIVER_CHARGER_CA_FILE=/etc/waybill/charger-ca.pem
WAYBILL_RECEIVER_API_CA_FILE=/etc/waybill/receiver-api-ca.pem
WAYBILL_RECEIVER_TEST_MODE=0
