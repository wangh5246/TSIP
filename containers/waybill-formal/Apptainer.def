Bootstrap: docker
From: waybill-formal:local

%labels
    org.opencontainers.image.title WayBill Formal Experiments
    org.opencontainers.image.version 1

%environment
    export PYTHONPATH=/work
    export PATH=/opt/waybill/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
    export WAYBILL_CONTAINER=1

%runscript
    exec python /work/script/waybill_formal.py "$@"

%test
    python --version | grep '3.12'
    node --version | grep 'v26.0.0'
    circom --version | grep '2.1.9'
    snarkjs --version | grep '0.7.6'
