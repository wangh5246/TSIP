{
  "schema": "waybill.formal.protocol/v1",
  "name": "waybill-v6-method-security-formal-server",
  "version": 1,
  "formal": true,
  "paper_track": "method-and-security",
  "output_root": "experiments/waybill_server_formal",
  "max_attempts_per_job": 2,
  "aggregate_attempt_policy": "first_success_else_all_attempts_reported",
  "formal_caps": {
    "max_trips": 0,
    "max_raw_points": 0,
    "limit_per_input": 0,
    "max_fixes": 0
  },
  "toolchain": {
    "python": "3.12",
    "node": "26.5.1",
    "npm": "11.17.0",
    "circom": "2.1.9",
    "circom_git_commit": "2eaaa6dface934356972b34cab64b25d382e59de",
    "snarkjs": "0.7.6",
    "circomlib": "2.0.5",
    "architecture": "linux-x86_64"
  },
  "datasets": [
    "tdrive",
    "geolife",
    "porto",
    "rome"
  ],
  "seeds": [
    17,
    31,
    47,
    73,
    101
  ],
  "statistics": {
    "cluster_unit": "original vehicle or user",
    "confidence_interval": "cluster bootstrap 95%",
    "bootstrap_replicates": 5000,
    "percentiles": [
      50,
      95,
      99
    ],
    "failed_timeout_or_oom_units": "retained and included in failure-rate and unresolved summaries"
  },
  "reporting": {
    "cross_seed_rule": "report every seed and the median/min/max across the five seeds for identical non-seed parameters",
    "multiplicity": "descriptive confidence intervals; no familywise confirmatory significance claim",
    "primary_endpoints": {
      "S1": [
        "rejected_periods",
        "max_v6_undercharge_cents",
        "max_withholding_advantage_cents",
        "identity-cluster bootstrap surcharge distribution"
      ],
      "S2": [
        "compile/setup/prove/verify latency and RSS by depth/fixes",
        "descriptive nearest-rank P50/P95/P99",
        "concurrency throughput"
      ],
      "S3": [
        "all main representatives at gap <= 0.01",
        "at least 0.95 of all instances certified at gap <= 0.05",
        "no soundness failure"
      ],
      "S4": [
        "identity-macro top1/top5 accuracy",
        "linkability AUC by disclosure view",
        "unique/low-privacy diagnostic distribution"
      ],
      "S5": [
        "end-to-end snarkjs CLI verification latency",
        "in-process FastAPI/SQLite handler correctness and latency",
        "no deployed PostgreSQL/server-throughput inference"
      ]
    }
  },
  "stages": {
    "S1": {
      "methods": [
        "oracle-position",
        "v5-dt-vmax-rmax",
        "v6-dodo-rmax",
        "v6-without-month-close"
      ],
      "month_close_ablation": "whole-period-withholding-with-versus-without-rmax-reconciliation",
      "rejected_period_policy": "fail-closed",
      "independent_mask_alpha": [
        0.05,
        0.1,
        0.2
      ],
      "burst_share": 0.1,
      "burst_lengths_fixes": [
        1,
        3,
        10
      ],
      "odometer_errors": [
        -0.02,
        -0.01,
        -0.005,
        0.0,
        0.005,
        0.01,
        0.02
      ],
      "odometer_contexts": [
        "natural",
        "independent-alpha-0.10"
      ],
      "timeout_sec": 86400,
      "resource": {
        "cpus": 4,
        "memory_gib": 16,
        "storage_gib_per_attempt": 0.05,
        "expected_cpu_hours_per_job": 0.5,
        "scheduler_max_parallel": 4
      }
    },
    "S2": {
      "depths": [
        8,
        12,
        14,
        16
      ],
      "fixes": [
        25,
        50,
        100,
        200
      ],
      "warmup_trials": 1,
      "measured_trials": 10,
      "concurrency_fixes": [
        100,
        200
      ],
      "concurrency": [
        1,
        2,
        4,
        8
      ],
      "concurrency_batches": 5,
      "timeout_sec_per_stage": 7200,
      "resource": {
        "cpus": 8,
        "memory_gib": 32,
        "memory_gib_per_concurrent_proof": 8,
        "storage_gib_per_attempt": 4,
        "expected_cpu_hours_per_job": 4,
        "scheduler_max_parallel": 1
      }
    },
    "S3": {
      "buckets_m": [
        100,
        50,
        25,
        10
      ],
      "attacker_or_relay_radius_m": [
        50,
        100,
        200
      ],
      "instance_timeout_sec": 7200,
      "timeout_sec": 28800,
      "oracle_max_fixes": 5,
      "main_gap_max": 0.01,
      "all_instance_certified_share_min": 0.95,
      "all_instance_gap_max": 0.05,
      "resource": {
        "cpus": 1,
        "memory_gib": 16,
        "storage_gib_per_attempt": 0.04,
        "expected_cpu_hours_per_job": 2.0,
        "scheduler_max_parallel": 8
      }
    },
    "S4": {
      "views": [
        {
          "view": "O0",
          "opening": 0.0
        },
        {
          "view": "O1",
          "opening": 0.0
        },
        {
          "view": "O2",
          "opening": 0.0
        },
        {
          "view": "O3",
          "opening": 0.0
        },
        {
          "view": "O3",
          "opening": 0.01
        },
        {
          "view": "O3",
          "opening": 0.05
        },
        {
          "view": "O3",
          "opening": 0.1
        }
      ],
      "horizons": [
        1,
        4,
        12
      ],
      "attackers": [
        "random-majority",
        "nearest-route",
        "supervised-linker"
      ],
      "split": "vehicle-or-user-disjoint",
      "temporal_gap_periods": 1,
      "gallery_query_overlap_policy": "forbid-any-shared-period",
      "statistics": {
        "cluster_unit": "original-vehicle-or-user",
        "bootstrap_replicates": 5000,
        "confidence_interval": 0.95,
        "aggregation": "macro-by-identity"
      },
      "view_schemas": {
        "O0": [
          "interval_count",
          "period_duration_sec",
          "total_distance_m",
          "total_fee_cents"
        ],
        "O1": [
          "fallback_indicator",
          "fallback_intervals",
          "interval_count",
          "period_duration_sec",
          "total_distance_m",
          "total_fee_cents"
        ],
        "O2": [
          "amount_bucket_500c",
          "distance_bucket_100m",
          "fallback_indicator",
          "fallback_intervals",
          "interval_count",
          "period_duration_sec"
        ],
        "O3": [
          "amount_bucket_500c",
          "distance_bucket_100m",
          "fallback_indicator",
          "fallback_intervals",
          "interval_count",
          "opened_cells",
          "period_duration_sec"
        ]
      },
      "timeout_sec": 43200,
      "resource": {
        "cpus": 8,
        "memory_gib": 32,
        "storage_gib_per_attempt": 0.02,
        "expected_cpu_hours_per_job": 0.5,
        "scheduler_max_parallel": 4
      }
    },
    "S5": {
      "fixes": [
        25,
        100,
        200
      ],
      "valid_bundle_corpus_per_fixes": 100,
      "corpus_concurrency": 8,
      "verifier_calls_per_fixes": 10000,
      "concurrency": [
        1,
        8,
        32
      ],
      "workloads": [
        "valid-100",
        "valid-95-tampered-5",
        "valid-90-tampered-5-replay-5"
      ],
      "repetitions": 3,
      "timeout_sec": 21600,
      "resource": {
        "cpus": 32,
        "memory_gib": 64,
        "storage_gib_per_attempt": 0.1,
        "expected_cpu_hours_per_job": 1,
        "scheduler_max_parallel": 1
      }
    }
  },
  "stop_rules": [
    "stop on code, protocol, container, data, tariff, or PTAU hash mismatch",
    "stop if a formal job is not launched by the bound network-isolated Apptainer runtime with image-embedded source and an intact run-input seal",
    "stop on missing expected job during strict merge",
    "stop S3 on LB greater than UB, infeasible incumbent, or invalid relaxation direction",
    "do not alter datasets, seeds, methods, timeout, or filtering during a formal run",
    "after two failed attempts retain the unit as unresolved; never delete it"
  ]
}
