# Runtime
FLUSH_SECONDS=2

# Shared proof config
PROOF_M=8
PROOF_ALPHA=0.05
PROOF_DIM=299
PROOF_B_SCALE=0.93
PROOF_CALIBRATE=1
PROOF_CALIBRATION_SAMPLES=800
MALICIOUS_RATE=0.1

# ZK step (stable defaults)
SHUFFLER_ZK_STEP_ENABLE=1
CLIENT_ZK_STEP_ENABLE=1
SHUFFLER_PROOF_ENABLE=0
CLIENT_PROOF_ENABLE=0
SHUFFLER_MAX_STEP_M=110.0
CLIENT_MAX_STEP_M=110.0
ZK_STEP_INDEX=10
ZK_STEP_VERIFY_TIMEOUT_SEC=30
ZK_STEP_TIMEOUT_SEC=20
ZK_STEP_PROVER=auto
RAPIDSNARK_BIN=/usr/local/bin/rapidsnark

# TSIP main proof (commitment-chain continuity)
SHUFFLER_TSIP_ENABLE=0
CLIENT_TSIP_ENABLE=0
TSIP_WINDOW_SEC=60
TSIP_MAX_GAP_WINDOWS=2
TSIP_VERIFY_TIMEOUT_SEC=30
TSIP_TIMEOUT_SEC=20
TSIP_PROVER=auto
TSIP_DEBUG=0
TSIP_BOOTSTRAP_POLICY=legacy_accept
TSIP_LOC_HASH_MODE=poseidon2
TSIP_POSEIDON_TIMEOUT_SEC=20
# Randomized TSIP verification (disabled by default)
TSIP_VERIFY_DP_ENABLE=0
TSIP_VERIFY_EPSILON=0.2
TSIP_VERIFY_NOISY_THRESHOLD=0.5
TSIP_VERIFY_DP_SEED=rise_fed

# ── P1: Enrollment Warmup ────────────────────────────────────────────────────
# Hold new users' submissions from aggregation for this many accepted rounds.
# Prevents a fresh account from immediately poisoning the aggregate with a
# fully-fabricated initial position (enrollment trust assumption mitigation).
# Default keeps warmup >= K for ADWC safety profile.
TSIP_WARMUP_ROUNDS=6

# ── C6: Anchor-Distance Window Continuity (ADWC) ──────────────────────────────
# ADWC is enforced in-circuit with two public caps:
#   d_anchor_sq <= cap_physics_sq  and  d_anchor_sq <= cap_policy_sq
# Profile defaults:
#   k6  -> K=6,  policy_cap=3.3km
#   k30 -> K=30, policy_cap=16.5km
TSIP_ADWC_PROFILE=k6
TSIP_ADWC_WINDOW_K=6
TSIP_ADWC_POLICY_CAP_M=3300

# ── P3: Server Trust Model ────────────────────────────────────────────────────
# Minimum number of distinct aggregator replicas that must have accepted a
# report.  With the current 2-aggregator design, setting to 2 adds a second
# independent acceptance gate; full collusion still degrades to DP-only output.
# TEE / MPC aggregators are left as future work.
TSIP_MIN_AGGREGATORS=1

# ── P4: Proof-Payload Binding ─────────────────────────────────────────────────
# When enabled, SHA-256(sorted cell indices) is folded into the chain
# commitment.  A valid proof cannot be detached from the payload it was
# generated for.  Requires client and server to be on the same version.
# For ZK-level binding see circuits/tsip_main_v2.circom.
TSIP_PAYLOAD_BINDING_ENABLE=1

# ── P5: Per-User Hidden Secret Binding ────────────────────────────────────────
# When enabled, HMAC-SHA256(user_secret, user_id) is folded into the chain
# commitment.  Prevents identity-swap attacks even when the attacker knows the
# victim's GPS coordinates.  The secret is generated on the client and never
# transmitted to the server.  For ZK-level binding see circuits/tsip_main_v2.circom.
TSIP_SECRET_BINDING_ENABLE=1
# Multi-shuffler threshold gate (disabled by default)
SHUFFLER_COMMITTEE_ENABLE=0
SHUFFLER_COMMITTEE_ID=s1
SHUFFLER_COMMITTEE_SIGN_SECRET=shuffler_sign_s1
SHUFFLER_COMMITTEE_SIGN_SECRET_S2=shuffler_sign_s2
SHUFFLER_COMMITTEE_SIGN_SECRET_S3=shuffler_sign_s3
SHUFFLER_COMMITTEE_THRESHOLD=1
SHUFFLER_COMMITTEE_PEERS=http://shuffler2:8001,http://shuffler3:8001
SHUFFLER_COMMITTEE_TIMEOUT_SEC=3
SHUFFLER_COMMITTEE_ATTEST_PATH=/committee/attest
SHUFFLER_COMMITTEE_TOKEN=
SHUFFLER_COMMITTEE_KEYS=s1:shuffler_sign_s1,s2:shuffler_sign_s2,s3:shuffler_sign_s3

# Client request pacing/timeouts
REPORT_TIMEOUT_SEC=20
SEND_INTERVAL_SEC=0.03
CLIENT_TOTAL=200
TSIP_USER_SCOPE=stable

# DP (Nebula-like) config in aggregator_a
DP_EPSILON_TOTAL=1.0
DP_EPSILON_SVT=0.3
DP_EPSILON_VAL=0.7
DP_TAU=3.0
DP_TAU2=3.0
DP_SENSITIVITY=1.0
DP_DECODE_ENABLE=0
